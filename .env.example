# LLM provider: anthropic (default), gemini, or nvidia
AI_PROVIDER=anthropic

# Anthropic-compatible HTTP provider. Keep values private.
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional compatibility fallback when ANTHROPIC_MODEL is empty.
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-8

# Optional Gemini provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional NVIDIA-compatible provider
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=google/gemma-4-31b-it

# App
# ENV=local keeps the in-memory dev fallback available when MONGO_URI is empty.
# ENV=production (or any VERCEL value) makes Mongo mandatory: a missing or
# unreachable MONGO_URI fails startup and /health instead of using memory.
ENV=local

# MongoDB persistence. Required when ENV=production or running on Vercel.
# Use a TLS SRV URI with a least-privilege database user.
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGO_URI=
MONGO_DB_NAME=sqlarena

# Authentication. Required for register/login/profile routes.
JWT_SECRET_KEY=
JWT_EXPIRE_HOURS=12

# Admin document import limit in bytes.
MAX_UPLOAD_BYTES=5242880

# Allow FastAPI BackgroundTasks generation in production. Off by default because
# BackgroundTasks is single-process and not durable.
ALLOW_BACKGROUND_JOBS=0

# Frontend dev origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
